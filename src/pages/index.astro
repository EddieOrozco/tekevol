---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Pricing from '@/components/Pricing.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import JsonLd from '@/components/JsonLd.astro';
import { homeTiers } from '@/data/pricing';
import { homeIndustries } from '@/data/industries';
import { site } from '@/data/site';

// Same order the HTML page loaded them
import '@/styles/variables.css';
import '@/styles/reset.css';
import '@/styles/base.css';
import '@/styles/layout.css';
import '@/styles/pages/home.css';
import '@/styles/components.css';
import '@/styles/components/buttons/button.css';
import '@/styles/components/cards/pricing.css';

const trustItems = [
  { value: '7 days', label: 'Average launch time' },
  { value: 'Mobile-first', label: 'Built for customers on their phones' },
  { value: 'Local SEO', label: 'Set up to show in "near me" searches' },
  { value: 'Flat pricing', label: 'No surprise invoices' },
];

const problems = [
  'It looks outdated and breaks on phones, where most customers search.',
  "You don't show up on Google, so the phone isn't ringing.",
  'Competitors with worse work are getting your calls.',
];

const fixes = [
  'A fast, modern site that looks sharp on every phone and screen.',
  'Local SEO so you show up when people search "plumber near me."',
  'Tap-to-call buttons and clear quotes that turn visitors into jobs.',
];

const steps = [
  { title: 'Call', text: 'A quick conversation about your business, your service area, and the jobs you want more of.' },
  { title: 'Build', text: 'We design and write your site. You review it, we refine it. No tech homework on your end.' },
  { title: 'Launch', text: 'We go live, connect your domain, and make sure calls and quote requests land where they should.' },
];

const ctaPoints = [
  'Built for plumbers, electricians, landscapers & more',
  'Mobile-first and fast on any phone',
  'No long contracts',
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: `${site.url}/`,
  logo: `${site.url}/assets/images/logo/logo.webp`,
  description: 'Website design for small businesses in the trades, including electricians, plumbers, HVAC companies, landscapers and many more.',
  email: site.email,
  areaServed: 'US',
  sameAs: [],
};
---
<BaseLayout
  title="Tekevol | Websites for Electricians, Plumbers & more."
  description="Tekevol builds fast, lead-generating websites for small businesses in the trades: electricians, plumbers, HVAC, landscapers and more. Get a free quote."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/images/hero/hero-mobile.webp" media="(max-width: 767px)" />
    <link rel="preload" as="image" href="/assets/images/hero/hero.webp" media="(min-width: 768px)" />
    <JsonLd data={orgSchema} />
  </Fragment>

  <main>
    <!-- ===== HERO ===== -->
    <section class="hero">
      <div class="container">
        <h1>A Website That Brings You More Customers</h1>
        <p class="subheadline">
          We design and build fast, modern websites that turn visitors into leads,
          without the agency runaround.
        </p>
        <div class="hero-ctas">
          <a href="/contact" class="btn btn-accent">Get Your Free Audit</a>
          <a href="/services" class="btn btn-outline">See Our Services</a>
        </div>
        <p class="cta-note">No obligation. Takes less than 2 minutes.</p>
      </div>
    </section>

    <!-- ===== Trust strip ===== -->
    <section class="trust-strip" aria-label="Why trades businesses choose Tekevol">
      <div class="container">
        <ul class="trust-list">
          {trustItems.map((item) => (
            <li class="trust-item">
              <span class="trust-value">{item.value}</span>
              <span class="trust-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== Problem / solution ===== -->
    <section class="problem-solution" aria-labelledby="ps-title">
      <div class="problem-solution__inner">
        <div class="problem-solution__header">
          <span class="eyebrow">Sound familiar?</span>
          <h2 id="ps-title" class="problem-solution__title">Your work is great. Your website should be too.</h2>
        </div>

        <div class="problem-solution__grid">
          <article class="ps-card ps-card--problem ps-reveal">
            <span class="ps-card__label">The problem</span>
            <h3 class="ps-card__heading">Your site is costing you jobs</h3>
            <ul class="ps-card__list">
              {problems.map((text) => <li><span class="ps-card__icon" aria-hidden="true">✕</span>{text}</li>)}
            </ul>
          </article>

          <div class="problem-solution__arrow" aria-hidden="true"><span>→</span></div>

          <article class="ps-card ps-card--solution ps-reveal">
            <span class="ps-card__label">The Tekevol fix</span>
            <h3 class="ps-card__heading">A site built to make the phone ring</h3>
            <ul class="ps-card__list">
              {fixes.map((text) => <li><span class="ps-card__icon" aria-hidden="true">✓</span>{text}</li>)}
            </ul>
          </article>
        </div>

        <div class="problem-solution__cta">
          <a href="/contact">Get more calls from Google</a>
        </div>
      </div>
    </section>

    <!-- ===== Pricing ===== -->
    <Pricing
      tiers={homeTiers}
      strongBestFor
      title="Choose the plan that fits your business"
      subtitle="From getting online to owning your local market. Start where you are and grow into more support as you need it."
    />

    <!-- ===== Industries ===== -->
    <section class="industries" id="industries" aria-labelledby="industries-title">
      <div class="container">
        <div class="industries-header">
          <span class="eyebrow">Industries Served</span>
          <h2 class="industries-title" id="industries-title">Built for the trades</h2>
          <p class="industries-lede">
            We build websites for the people who keep homes and businesses running.
            Find your trade below.
          </p>
        </div>

        <ul class="industries-grid" role="list">
          {homeIndustries.map((ind) => (
            <li>
              <a class="industry-card" href={`/industries#${ind.slug}`}>
                <span class="industry-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={ind.icon} />
                </span>
                <span class="industry-name">{ind.name}</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="industries-footer">
          <p>Don't see your trade? We probably work with it.</p>
          <a class="industries-link" href="/industries">
            See all industries
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ===== Process ===== -->
    <section class="process" id="process" aria-labelledby="process-title">
      <div class="container">
        <div class="process-header">
          <span class="eyebrow">How it Works</span>
          <h2 class="process-title" id="process-title">From first call to launch day</h2>
          <p class="process-intro">
            Three simple steps. You run your business. We handle the website.
          </p>
        </div>

        <ol class="process-steps">
          {steps.map((step, i) => (
            <li class="process-step">
              <span class="process-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="process-body">
                <h3 class="process-step-title">{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="process-cta">
          <a class="process-link" href="/why-us">
            Why Tekevol
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ===== Quote form ===== -->
    <section class="final-cta" id="quote" aria-labelledby="final-cta-title">
      <div class="container final-cta__inner">
        <div class="final-cta__copy">
          <p class="final-cta__eyebrow">Free Audit · No obligation</p>
          <h2 class="final-cta__title" id="final-cta-title">
            Ready for a website that brings in <span>more calls?</span>
          </h2>
          <p class="final-cta__text">
            Tell us about your business and we'll send a clear, free audit within one business day.
          </p>
          <ul class="final-cta__points">
            {ctaPoints.map((p) => <li>{p}</li>)}
          </ul>
          <!-- Phone block goes here once the business number is ready -->
        </div>

        <div class="final-cta__card">
          <QuoteForm />
        </div>
      </div>
    </section>
  </main>

  <!-- Pre-footer CTA band -->
  <section slot="before-footer" class="footer-cta" aria-labelledby="footer-cta-title">
    <div class="footer-cta__inner">
      <div>
        <h2 class="footer-cta__title" id="footer-cta-title">Ready to make the phone ring?</h2>
        <p class="footer-cta__text">Get a website that looks great and brings in local jobs.</p>
      </div>
    </div>
  </section>
</BaseLayout>
