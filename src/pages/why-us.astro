---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import JsonLd from '@/components/JsonLd.astro';
import { whyUsFaq } from '@/data/faq';
import { site } from '@/data/site';

import '@/styles/variables.css';
import '@/styles/reset.css';
import '@/styles/base.css';
import '@/styles/layout.css';
import '@/styles/pages/why-us.css';
import '@/styles/components.css';
import '@/styles/components/buttons/button.css';
import '@/styles/components/faq/faq.css';
import '@/styles/components/sections/final-cta.css';

const pains = [
  "You paid someone for a website and haven't heard from them since.",
  'Your site is slow on phones where 70%+ of your customers are searching.',
  "Your competitor shows up in the Google Map pack. You don't.",
  "Every agency call is full of jargon, and you still don't know what you're paying for.",
];

const reasons = [
  {
    title: 'Built only for the trades',
    text: 'We know how your customers search "emergency plumber near me," "panel upgrade cost." Every page is written to match.',
    icon: '<path d="M14.7 6.3a4 4 0 00-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 005.4-5.4l-2.5 2.5-2.5-2.5z"/>',
  },
  {
    title: 'Fast, hand-coded sites',
    text: 'No bloated page builders or plugins. Your site loads in about a second, even on a job-site cell signal and Google rewards that.',
    icon: '<path d="M13 2L3 14h9l-1 8 10-12h-9z"/>',
  },
  {
    title: 'Designed to get calls',
    text: 'Tap-to-call buttons on every screen, clear service areas, and quote forms that take 30 seconds. Pretty is nice. Calls pay the bills.',
    icon: '<path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.4 1.8.7 2.7a2 2 0 01-.5 2.1L8 9.8a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.8.6 2.7.7a2 2 0 011.7 2z"/>',
  },
  {
    title: 'Local SEO that actually works',
    text: 'We manage your Google Business Profile, post weekly, monitor reviews, and clean up your listings so you show up in the Map pack.',
    icon: '<path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    title: 'You own everything',
    text: 'Your domain, your content, your files. No hostage situations. If you ever leave, we hand it all over.',
    icon: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>',
  },
  {
    title: 'Plain-English reporting',
    text: 'A simple monthly report: calls, form leads, and where you rank. No jargon. Questions? You talk directly to the person who built your site.',
    icon: '<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>',
  },
];

// Comparison table. `yes`/`no` add the coloured badge; plain strings don't.
type Cell = string | { yes: string } | { no: string };
const compareRows: { label: string; us: Cell; diy: Cell; agency: Cell }[] = [
  { label: 'Built for the trades', us: { yes: 'Yes' }, diy: { no: 'No' }, agency: { no: 'Rarely' } },
  { label: 'We write your content', us: { yes: 'Yes' }, diy: { no: 'You do' }, agency: 'Extra cost' },
  { label: 'Fast on mobile', us: { yes: 'Yes' }, diy: 'Hit or miss', agency: 'Hit or miss' },
  { label: 'Google Business Profile management', us: { yes: 'Included*' }, diy: { no: 'No' }, agency: 'Extra cost' },
  { label: 'You own your site', us: { yes: 'Always' }, diy: { no: 'Locked to platform' }, agency: 'Depends on contract' },
  { label: 'Upfront cost', us: 'Starts at $500', diy: 'Low, plus your time', agency: '$3,000–$10,000+' },
];

const steps = [
  { title: 'Free audit', text: "We review your current site and Google listing and show you exactly what's costing you calls." },
  { title: '30min interview', text: 'Tell us about your services and service area. We write every page for you.' },
  { title: 'Launch', text: 'Your new site goes live in about [2–4] weeks. Hosting, SSL, and backups included.' },
  { title: 'Grow', text: 'We keep it secure, updated, and climbing in local search with a report every month.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: whyUsFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Why Choose Tekevol | Web Design for Small Businesses"
  description="Websites built to bring in calls and quote requests, not just look good. See how Tekevol works with trade and local businesses."
>
  <Fragment slot="head">
    <meta property="og:title" content="Why Tekevol — Websites Built for the Trades" />
    <meta property="og:description" content="Fast websites and local marketing that make the phone ring for plumbers, electricians, landscapers, and HVAC pros." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site.url}/why-us`} />
    <meta property="og:image" content={`${site.url}/assets/images/logo/logo.webp`} />
    <JsonLd data={faqSchema} />
  </Fragment>

  <main>
    <!-- 1. HERO -->
    <section class="why-hero">
      <div class="container why-hero__inner">
        <p class="eyebrow eyebrow__accent">Why Tekevol</p>
        <h1>You're great at your trade. We're great at getting you found.</h1>
        <p class="why-hero__lead">
          We build websites for businesses across a range of industries. We take the time to understand your company and your customers, then create a site that helps people feel confident choosing you and makes it easy to get in touch.
        </p>
        <div class="why-hero__actions">
          <a href="/contact" class="btn btn-accent">Book Your Free Audit</a>
          <a href="/services#pricing" class="btn btn-outline">See Pricing</a>
        </div>
      </div>
    </section>

    <!-- 2. THE PROBLEM -->
    <section class="why-section">
      <div class="container why-narrow">
        <h2>Sound familiar?</h2>
        <ul class="why-pain">
          {pains.map((p) => <li>{p}</li>)}
        </ul>
        <p class="why-pain__close">You don't need more marketing buzzwords. You need more calls. That's what we fix.</p>
      </div>
    </section>

    <!-- 3. DIFFERENTIATORS -->
    <section class="why-section why-section--alt" aria-labelledby="reasons-heading">
      <div class="container">
        <h2 id="reasons-heading" class="why-center">What makes us different</h2>
        <div class="why-grid">
          {reasons.map((r) => (
            <article class="why-card">
              <svg class="why-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={r.icon} />
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. COMPARISON TABLE -->
    <section class="why-section" aria-labelledby="compare-heading">
      <div class="container">
        <h2 id="compare-heading" class="why-center">Tekevol <br />vs<br />The Other Options</h2>
        <div class="why-table-wrap">
          <table class="why-table">
            <caption class="visually-hidden">Comparison of Tekevol, DIY website builders, and typical agencies</caption>
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Feature</span></th>
                <th scope="col" class="why-table__us">Tekevol</th>
                <th scope="col">DIY builder</th>
                <th scope="col">Typical agency</th>
              </tr>
            </thead>
            <tbody>
              {compareRows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {[row.us, row.diy, row.agency].map((cell, i) => (
                    <td class={i === 0 ? 'why-table__us' : undefined}>
                      {typeof cell === 'string'
                        ? cell
                        : 'yes' in cell
                          ? <span class="yes">{cell.yes}</span>
                          : <span class="no">{cell.no}</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="why-footnote">*Included in the <a href="/services#evolve-make-the-phone-ring">Make the Phone Ring</a> plan.</p>
      </div>
    </section>

    <!-- 5. HOW IT WORKS -->
    <section class="why-section why-section--alt" aria-labelledby="process-heading">
      <div class="container">
        <h2 id="process-heading" class="why-center">How it works</h2>
        <ol class="why-steps">
          {steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. FOUNDER / TRUST — add back when ready (photo: /assets/images/hero-main.webp) -->
    <!-- 7. TESTIMONIALS — add once you have REAL client quotes (with permission) -->

    <!-- 8. FAQ (same list feeds the structured data above) -->
    <section class="why-section section-alt" aria-labelledby="faq-heading">
      <div class="container">
        <h2 id="faq-heading" class="why-center">Common questions</h2>
        <div class="why-faq">
          {whyUsFaq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. FINAL CTA -->
    <CtaBand
      btnRow={false}
      title="Find out what's costing you calls"
      text="Get a free, no-pressure audit of your website and Google listing. Takes 15 minutes."
    />
  </main>
</BaseLayout>
