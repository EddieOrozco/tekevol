---
import BaseLayout from '@/layouts/BaseLayout.astro';

import '@/styles/reset.css';
import '@/styles/variables.css';
import '@/styles/base.css';
import '@/styles/layout.css';
import '@/styles/components.css';
import '@/styles/components/buttons/button.css';
import '@/styles/pages/404.css';
---
<BaseLayout title="Page Not Found | Tekevol" robots="noindex" canonical={false}>
  <main class="not-found">
    <div class="not-found__inner">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">This page doesn't exist.</h1>
      <p class="not-found__text">
        The link may be broken, or the page may have moved. Here are a few places to go instead.
      </p>

      <div class="not-found__actions">
        <a class="not-found__btn not-found__btn--primary" href="/">Back to home</a>
        <a class="not-found__btn not-found__btn--secondary" href="/contact">Get a free quote</a>
      </div>

      <ul class="not-found__links">
        <li><a href="/services">Services &amp; packages</a></li>
        <li><a href="/industries">Industries we serve</a></li>
        <li><a href="/why-us">Why Tekevol</a></li>
      </ul>
    </div>
  </main>
</BaseLayout>
